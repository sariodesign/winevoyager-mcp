{
  "name": "winevoyager-mcp",
  "version": "0.3.3",
  "description": "MCP server for the WineVoyager API: verified data on Italian DOCG and DOC wine denominations, read from the official MASAF disciplinari.",
  "mcpName": "tours.winevoyager/mcp",
  "type": "module",
  "license": "MIT",
  "author": "WineVoyager (https://www.winevoyager.tours/developers)",
  "homepage": "https://github.com/sariodesign/winevoyager-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sariodesign/winevoyager-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sariodesign/winevoyager-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "winevoyager-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/check-stdio.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wine",
    "italy",
    "docg",
    "doc",
    "appellations"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
